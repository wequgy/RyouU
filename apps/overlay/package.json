{
  "name": "unclone-overlay",
  "version": "1.0.0",
  "description": "Unclone Real-Time Interview Integrity Monitoring Overlay",
  "main": "src/main/main.js",
  "author": "Unclone Team",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "31.3.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.unclone.overlay",
    "productName": "Unclone Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
