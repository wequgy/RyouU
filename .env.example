# Copy to .env and export (e.g. `set -a; source .env; set +a`)
KYC_DEV_MODE=1                      # echoes OTP codes in API responses. NEVER in production.
KYC_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000
FLOW_BASE_URL=http://localhost:3000/verify
KYC_CORS_ORIGINS=*

# Demo tenants' webhook target (the demo client app)
DEMO_WEBHOOK_URL=http://localhost:9000/webhooks/kyc
DEMO_WEBHOOK_SECRET=whsec_demo

# Detectif.ai (backend only; never ship this key to the browser)
DETECTIF_API_KEY= dtf_live_yB2j5vjBdPyu1bXwteva1ocrXh6NP8wtyortPw5Y3SD
DETECTIF_BASE_URL=https://platform.detectif.ai/v1

# Face thresholds are PLACEHOLDERS. Calibrate on your own ID-photo vs selfie pairs.
FACE_PASS_SIM=0.40
FACE_FAIL_SIM=0.25

# Optional real email OTP (otherwise codes are printed in the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
