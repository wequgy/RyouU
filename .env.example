# Copy to .env. Never commit .env.
KYC_DEV_MODE=0                 # 1 echoes OTP codes and relaxes CORS. NEVER in production
KYC_SEED_DEMO=0                # 1 creates demo tenants with PUBLIC keys. Dev only
KYC_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000
FLOW_BASE_URL=http://localhost:8000/flow
DETECTIF_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional tuning
FACE_PASS_SIM=0.40
FACE_FAIL_SIM=0.25
DEEPFAKE_PASS=0.30
DEEPFAKE_FAIL=0.70
